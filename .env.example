# Copy this file to .env to change the defaults used by compose.yaml.
# Docker Compose reads .env automatically; every line is optional.

# Host port the API is published on (127.0.0.1 only).
APP_PORT=8000

# Browser origins allowed to call the API, comma-separated. Leave empty to disable
# cross-origin browser access. The default allows the standalone backtest page.
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Memory limit for the container. Raise it if you upload several large CDR files at once.
APP_MEM_LIMIT=2g
