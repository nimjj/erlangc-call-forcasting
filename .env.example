# Copy this file to .env
# Host port the API is published on
APP_PORT=8010

# Browser origins allowed to call the API, comma-separated.
# Configured for localhost on ports 8080 and 8081 (as well as 3000, 5173).
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000,http://localhost:5173

# Required by every /api request (X-Internal-Key header) when set. Use the same value in ciap-api.
INTERNAL_API_KEY=
# Worker processes for forecasts; requests beyond these plus MAX_QUEUED_COMPUTATIONS get 503.
FORECAST_PROCESSES=2
MAX_QUEUED_COMPUTATIONS=4
# false = log to stdout only (no logs/ folder needed).
LOG_TO_FILE=true
